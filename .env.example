# ── LLM Backend ──────────────────────────────────────────────────────────
# openai = OpenAI Cloud | self_hosted = Model tự host (vLLM/Ollama OpenAI-compatible)
LLM_BACKEND=openai

# 1. Cấu hình OpenAI Cloud (khi LLM_BACKEND=openai)
OPENAI_API_KEYS=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

# 2. Cấu hình Model tự host / Self-hosted LLM (khi LLM_BACKEND=self_hosted)
# Ví dụ: Qwen3-4B tại KCN Hưng Phú
MODEL_BASE_URL=http://192.168.1.196:18083/v1
MODEL_NAME=qwen3-4b
MODEL_API_KEY=
MODEL_ENDPOINT=http://192.168.1.196:18083/v1/chat/completions

# Bước "Answer" (diễn giải số liệu → câu trả lời tiếng Việt)
# Đặt true để dùng LLM diễn giải tự nhiên; false để dùng template tĩnh (phù hợp GPU yếu)
ANSWER_USE_LLM=true

# ── Database Nguồn Thống Kê (Postgres, READ-ONLY) ───────────────────────────
# Dùng role riêng CHỈ có quyền SELECT trên các DB bên dưới (KHÔNG dùng user admin/superuser)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME_ITS=its
DB_NAME_FENCE=virtual_fence
DB_NAME_FACE=smart_face
DB_NAME_FIRE=firesmoke
DB_NAME_ANOMALY=anomaly

# Lọc theo 1 tổ chức cụ thể (organization_id) nếu server có nhiều tổ chức
# 106 = KCN Hưng Phú (để 0 = không lọc)
DB_ORGANIZATION_ID=0
DB_QUERY_TIMEOUT_S=5.0
DB_MAX_ROWS=200

# ── Guardrails ───────────────────────────────────────────────────────────
GUARDRAILS_MIN_ANSWER_LEN=5
GUARDRAILS_MAX_ANSWER_LEN=2000

# ── Observability (Langfuse Tracing Self-hosted) ─────────────────────────
# Mặc định false — không cần chạy Langfuse để dùng phần còn lại của app.
# Tự host trên chính máy này qua Docker Compose — cổng 3000 (User: admin@agent-atin.local / Pass: Atin@123#)
MONITORING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Service Ports (Docker Compose) ─────────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000
