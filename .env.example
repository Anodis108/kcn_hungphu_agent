# ── LLM backend ──────────────────────────────────────────────────────────
# openai = OpenAI Cloud | ollama = model local (4GB VRAM, vd. qwen2.5:3b-instruct)
LLM_BACKEND=openai
# Override base_url (để trống = mặc định của backend):
#   ollama → http://localhost:11434/v1
LLM_BASE_URL=

# Chỉ cần khi LLM_BACKEND=openai. Có thể đặt NHIỀU key, ngăn cách bằng dấu
# phẩy, để bật key rotation (tự chuyển key khi gặp rate-limit).
OPENAI_API_KEYS=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

# Bước "Answer" (diễn giải số liệu → câu trả lời tiếng Việt) dùng 1 lời gọi
# LLM ngắn. Đặt false để dùng template dựng sẵn — nhanh hơn, không cần chờ
# LLM, phù hợp khi chạy model local chậm trên máy yếu.
ANSWER_USE_LLM=true

# ── Database nguồn thống kê (Postgres, READ-ONLY) ───────────────────────────
# Dùng role riêng CHỈ có quyền SELECT trên các DB bên dưới (KHÔNG dùng user
# admin/superuser) — xem README mục "Tạo DB role read-only".
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME_ITS=its
DB_NAME_FENCE=virtual_fence
# 3 DB mới (Phase 2, specs/implementation-plan.md) — role đọc-only đã được
# GRANT SELECT trên cả 3 (xem specs/change-log.md 2026-09-17). CHƯA dùng ở
# src/db/connection.py — whitelist mở rộng thuộc Phase 3, chưa code.
DB_NAME_FACE=smart_face
DB_NAME_FIRE=firesmoke
DB_NAME_ANOMALY=anomaly
# Lọc theo 1 tổ chức cụ thể (organization_id) nếu server có nhiều tổ chức
# dùng chung DB — để 0 = không lọc (chỉ an toàn khi DB chỉ có 1 tổ chức).
DB_ORGANIZATION_ID=0
DB_QUERY_TIMEOUT_S=5.0
DB_MAX_ROWS=200

# ── Guardrail output ─────────────────────────────────────────────────────
# Câu trả lời ngắn hơn mức này bị coi là bất thường (fallback); dài hơn mức
# max thì cắt bớt — tránh output rỗng/quá dài lọt ra UI.
GUARDRAILS_MIN_ANSWER_LEN=5
GUARDRAILS_MAX_ANSWER_LEN=2000

# ── Observability (Langfuse, Phase 4) ───────────────────────────────────
# Mặc định false — không cần chạy Langfuse để dùng phần còn lại của app.
# Tự host trên chính máy này qua langfuse/docker-compose.yml (xem README/
# specs/change-log.md 2026-09-17) — KHÔNG dùng Langfuse Cloud.
MONITORING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
